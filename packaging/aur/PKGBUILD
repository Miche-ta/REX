# Maintainer: Miche-ta <https://github.com/Miche-ta/rex-music>
pkgname=rex-music
pkgver=0.1.0
pkgrel=1
pkgdesc="Bit-perfect, gapless audiophile music player (direct ALSA hw:, DSD/DoP, CUE, FFT/Scope)"
arch=('x86_64' 'aarch64')
url="https://github.com/Miche-ta/rex-music"
license=('GPL-3.0-or-later')
depends=(
  'alsa-lib'
  'dbus'
  'gtk3'
  'hicolor-icon-theme'
  'webkit2gtk-4.1'
)
optdepends=(
  'pipewire-pulse: automatic PipeWire sink hand-off via pactl'
  'rtkit: real-time audio writer thread priority'
)
makedepends=(
  'cargo'
  'rust'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname-$pkgver/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname-$pkgver/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$pkgname-$pkgver/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/rex-music" "$pkgdir/usr/bin/rex-music"
  install -Dm644 "packaging/linux/rex-music.desktop" "$pkgdir/usr/share/applications/rex-music.desktop"
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/rex-music.png"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/rex-music.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/rex-music.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
