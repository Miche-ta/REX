[Desktop Entry]
Name=rex-music
Comment=Bit-perfect, gapless audiophile music player
Exec=rex-music %U
Icon=rex-music
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=audio/flac;audio/wav;audio/x-wav;audio/mpeg;audio/mp4;audio/ogg;audio/x-dsf;audio/x-dff;application/x-cue;
StartupWMClass=rex-music
Keywords=music;audio;player;flac;dsd;bit-perfect;alsa;
