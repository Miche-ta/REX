{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rex-music",
  "version": "0.1.0",
  "identifier": "io.github.micheta.rex-music",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rex-music",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Bit-perfect, gapless audiophile music player",
    "longDescription": "rex-music is a bit-perfect, gapless desktop music player with direct hardware output (ALSA hw:, WASAPI Exclusive, CoreAudio Hog Mode), DSD/DoP, CUE sheets, and latency-compensated FFT/phase visualizers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "sound",
        "depends": [
          "libasound2",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib",
          "webkit2gtk4.1",
          "gtk3",
          "dbus-libs"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
